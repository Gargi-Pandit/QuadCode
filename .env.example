# Copy to .env and fill in only the keys for providers referenced in config.yaml.
# The default config.yaml uses free tiers only and needs just GROQ_API_KEY (all four slots run on Groq).
# GEMINI_API_KEY and OPENROUTER_API_KEY are for the commented-out alternatives; DEEPSEEK_API_KEY is
# optional (prepaid only; never add a card or top up).
# Keys are read by the orchestrator process only; they are never logged and never passed to the sandbox.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
